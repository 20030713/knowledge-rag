# 复制为 .env 后再填写。不要把 .env 提交到 Git 或上传到公开位置。

# 至少 24 位随机字符串；三个密码不要相同。
MYSQL_ROOT_PASSWORD=replace-with-a-random-root-password
MYSQL_PASSWORD=replace-with-a-random-app-password
PGVECTOR_PASSWORD=replace-with-a-random-vector-password

# 至少 32 字节，建议使用 openssl rand -base64 48 生成。
JWT_SECRET=replace-with-a-long-random-jwt-secret-at-least-32-bytes
JWT_EXPIRE_HOURS=24

# 宝塔 Nginx 只反向代理这个本机端口。
FRONTEND_HOST_PORT=15173

# DeepSeek Chat 模型。
CHAT_MODEL_ENABLED=true
CHAT_MODEL_BASE_URL=https://api.deepseek.com
CHAT_MODEL_ENDPOINT_PATH=/v1/chat/completions
CHAT_MODEL_API_KEY=replace-with-your-new-deepseek-api-key
CHAT_MODEL_NAME=deepseek-v4-pro
CHAT_MODEL_TIMEOUT_SECONDS=45
CHAT_MODEL_THINKING_ENABLED=false
CHAT_MODEL_REASONING_EFFORT=high

# 阿里云百炼 Embedding。
EMBEDDING_MODEL_ENABLED=true
EMBEDDING_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL_ENDPOINT_PATH=/embeddings
EMBEDDING_MODEL_API_KEY=replace-with-your-new-bailian-api-key
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_MODEL_TIMEOUT_SECONDS=45
EMBEDDING_MODEL_DIMENSIONS=1024

PGVECTOR_ENABLED=true
PGVECTOR_DIMENSIONS=1024
UPLOAD_MAX_SIZE_MB=20
